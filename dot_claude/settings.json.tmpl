{
  "statusLine": {
    "type": "command",
    "command": "python3 $HOME/.claude/statusline.py"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(tr:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(type:*)",
      "Bash(lsof:*)",
      "Bash(ps:*)",
      "Bash(top:*)",
      "Bash(htop:*)",
      "Bash(netstat:*)",
      "Bash(ss:*)",
      "Bash(ping:*)",
      "Bash(nslookup:*)",
      "Bash(dig:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git tag:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(history:*)",
      "Bash(alias:*)",
      "Bash(true:*)",
      "Bash(false:*)",
      "Bash(test:*)",
      "Bash(docker images:*)",
      "Bash(docker ps:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(xargs:*)",
      "Bash(tee:*)",
      "Bash(readlink:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)"{{ if ne .chezmoi.os "darwin" }},
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(systemctl status:*)",
      "Bash(journalctl:*)",
      "Bash(which:*)",
      "Bash(rpm:*)",
      "Bash(dpkg:*)"{{ end }}
    ]
  }
}
